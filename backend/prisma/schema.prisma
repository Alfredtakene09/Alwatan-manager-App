generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GESTIONNAIRE
  RECEPTIONNISTE
  MEDECIN
  COMPTABLE
  LABORANTIN
  SOIGNANT
  PHARMACIEN
  LOGISTIQUE
}

enum VisitStatus {
  WAITING_CONSULTATION
  IN_CONSULTATION
  NEEDS_SURGERY
  NEEDS_HOSPITALIZATION
  AWAITING_ACCOUNTING
  IN_TREATMENT
  COMPLETED
  CANCELLED
}

enum RoomType {
  VIP
  SIMPLE
}

enum SurgeryStatus {
  NOTIFIED
  QUOTED
  PAID
  AUTHORIZED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HospitalizationStatus {
  REQUESTED
  RESERVED
  ACTIVE
  DISCHARGED
  CANCELLED
}

enum DoctorCompensationType {
  QUOTA
  FIXED_SALARY
  COMBINED
}

enum ConsultationRenewalPolicy {
  FULL
  HALF
}

enum ConsultationQuotaMode {
  PERCENT
  FIXED_AMOUNT
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PatientCategory {
  STANDARD
  ASSOCIE
  ONG
  PERSONNEL
}

enum InvoiceType {
  SURGERY
  HOSPITALIZATION_DEPOSIT
  HOSPITALIZATION_FINAL
  PHARMACY
  CONSULTATION
  LAB_EXAM
}

enum ReceptionShiftSlot {
  MORNING
  EVENING
  NIGHT
}

enum InterventionCategory {
  MAJEURE_A
  MOYENNE_B
  PETITE_C
}

enum ExamCatalogKind {
  EXAMEN
  ODONTO
  RADIO
  ECHO
}

enum PatientDocumentKind {
  EXAMEN
  ODONTO
  RADIO
  ECHO
  CONSULTATION
  AUTRE
}

enum ExamReclamationStatus {
  PENDING
  IN_PROGRESS
  REFUNDED
  REJECTED
}

enum ExamReclamationReason {
  EXAM_MISSING
  RESULT_MISSING
  ERROR
  OTHER
}

model EmployeeJobTitle {
  id        String   @id @default(cuid())
  label     String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicService {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  /// Médecins rattachés (plusieurs services possibles par médecin)
  serviceDoctors ClinicServiceDoctor[]
  examCatalogItems ExamCatalogItem[]
  examCatalogServiceTabs ExamCatalogServiceTab[]
  interventionTypes InterventionType[]
  /// Visites en attente assignées à ce service (transfert inter-services)
  assignedVisits Visit[]

  @@index([active, sortOrder, name])
}

/// Lien médecin ↔ service clinique (plusieurs services ; un seul isDefault).
model ClinicServiceDoctor {
  id              String   @id @default(cuid())
  employeeId      String
  clinicServiceId String
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clinicService ClinicService @relation(fields: [clinicServiceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, clinicServiceId])
  @@index([clinicServiceId])
  @@index([employeeId, isDefault])
}

model Employee {
  id                       String                 @id @default(cuid())
  firstName                String
  lastName                 String
  phone                    String?
  jobTitle                 String?
  isMedecin                Boolean                @default(false)
  doctorCompensationType   DoctorCompensationType @default(QUOTA)
  consultationTotalFcfa    Int?
  consultationQuotaMode    ConsultationQuotaMode  @default(PERCENT)
  consultationQuotaPercent Int?
  consultationQuotaFcfa    Int?
  consultationValidityDays Int?
  consultationRenewalPolicy ConsultationRenewalPolicy @default(FULL)
  surgeryQuotaPercent      Int?
  fixedSalaryFcfa          Int?
  birthDate                DateTime?              @db.Date
  address                  String?
  service                  String?
  /// Service clinique par défaut (consultation / catalogue examens)
  clinicServiceId          String?
  hiredAt                  DateTime?              @db.Date
  contractType             ContractType?
  contractStatus           EmployeeContractStatus @default(ACTIF)
  bonusFcfa                Int?
  /// Taux horaire des heures supplémentaires (médecins)
  overtimeHourlyRateFcfa   Int?
  photoPath                String?
  /// Spécialité médicale (médecins uniquement)
  specialty                String?
  /// Créneaux hebdomadaires : [{ dayOfWeek: 1-7 (lun–dim), startTime, endTime }]
  availabilitySlots        Json?
  active                   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  clinicService ClinicService? @relation(fields: [clinicServiceId], references: [id], onDelete: SetNull)
  /// Tous les services auxquels le médecin est rattaché (réception)
  clinicServiceLinks ClinicServiceDoctor[]
  user     User?
  payrolls EmployeePayroll[]
  salaryAdvances SalaryAdvance[]
  overtimeEntries DoctorOvertimeEntry[]
  doctorShareClaims DoctorShareClaim[]

  @@index([clinicServiceId])
}

model User {
  id            String              @id @default(cuid())
  username      String              @unique
  email         String              @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole
  active        Boolean             @default(true)
  /// Médecin disponible pour de nouveaux patients à la réception (false = en pause)
  acceptingPatients Boolean         @default(true)
  /// Tentatives de mot de passe incorrectes consécutives
  failedLoginAttempts Int           @default(0)
  /// Verrouillage après trop d'échecs — seul un ADMIN peut déverrouiller / réinitialiser le MDP
  lockedAt            DateTime?
  /// jti JWT de la session unique active (une seule connexion à la fois)
  sessionTokenId      String?
  /// Dernière activité API — session expirée après 30 min d'inactivité
  lastActivityAt      DateTime?
  employeeId    String              @unique
  /// Créneau caisse assigné (obligatoire pour les réceptionnistes)
  cashShiftSlot ReceptionShiftSlot?
  /// Actions UI masquées en plus des réglages du rôle (ex. un laborantin sans impression).
  hiddenUiActions Json               @default("[]")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  employee              Employee            @relation(fields: [employeeId], references: [id])
  recordedVitals        VitalSign[]
  consultations         Consultation[]
  surgeriesAsSurgeon    SurgeryCase[]       @relation("SurgeonCases")
  surgeriesAsAccountant SurgeryCase[]       @relation("SurgeryAccountant")
  surgeonPayments       SurgeryCase[]       @relation("SurgeonPayer")
  assistantPayments     SurgeryCase[]       @relation("AssistantPayer")
  clinicSharePayments   SurgeryCase[]       @relation("ClinicPayer")
  interventionsAsSurgeon          InterventionType[] @relation("InterventionSurgeon")
  interventionsAsAnesthesiologist InterventionType[] @relation("InterventionAnesthesiologist")
  interventionTypeAuthorizations  InterventionTypeSurgeon[] @relation("InterventionAuthorizedSurgeons")
  hospitalizations      Hospitalization[]   @relation("HospitalizationAccountant")
  invoices              Invoice[]
  invoicePaymentsRecorded InvoicePayment[] @relation("InvoicePaymentRecordedBy")
  prescriptions         Prescription[]
  auditLogs             AuditLog[]
  assignedVisits        Visit[]             @relation("VisitAssignedDoctor")
  labApprovals          Consultation[]      @relation("LabApprovedBy")
  labRecordings         Consultation[]      @relation("LabRecordedBy")
  uploadedDocuments     PatientDocument[]
  receptionCashSettlementsAsReceptionist ReceptionCashSettlement[] @relation("SettlementReceptionist")
  receptionCashSettlementsAsAccountant   ReceptionCashSettlement[] @relation("SettlementAccountant")
  receptionDayClosures                   ReceptionDayClosure[]
  receptionDayClosuresValidated          ReceptionDayClosure[]     @relation("DayClosureValidatedBy")
  clinicExpensesPaid                     ClinicExpense[]           @relation("ExpensePaidBy")
  clinicExpensesRecorded                 ClinicExpense[]           @relation("ExpenseRecordedBy")
  changeTransfersAsRequester             CashChangeTransfer[]      @relation("ChangeRequester")
  changeTransfersAsProvider              CashChangeTransfer[]      @relation("ChangeProvider")
  changeTransfersRecorded                CashChangeTransfer[]      @relation("ChangeRecordedBy")
  changeTransfersRefunded                CashChangeTransfer[]      @relation("ChangeRefundedBy")
  examReclamationsCreated                ExamReclamation[]         @relation("ExamReclamationCreatedBy")
  examReclamationsHandled                ExamReclamation[]         @relation("ExamReclamationHandledBy")
  payrollsPaid                           EmployeePayroll[]         @relation("PayrollPaidBy")
  salaryAdvancesRecorded                 SalaryAdvance[]           @relation("SalaryAdvanceRecordedBy")
  expensesValidated                      ClinicExpense[]           @relation("ExpenseValidatedBy")
  overtimeEntriesRecorded                DoctorOvertimeEntry[]     @relation("OvertimeRecordedBy")
  overtimeEntriesValidated               DoctorOvertimeEntry[]     @relation("OvertimeValidatedBy")
  overtimeEntriesPaid                    DoctorOvertimeEntry[]     @relation("OvertimePaidBy")
  doctorShareClaimsAsDoctor              DoctorShareClaim[]        @relation("DoctorShareClaims")
  doctorShareClaimsRequested             DoctorShareClaim[]        @relation("DoctorShareRequestedBy")
  doctorShareClaimsSettled               DoctorShareClaim[]        @relation("DoctorShareSettledBy")
  pharmacyStockMovements                 StockMovement[]
  logisticsStockMovements                LogisticsStockMovement[]
  logisticsRequestsCreated               LogisticsRequest[]        @relation("LogisticsRequestRequestedBy")
  logisticsRequestsHandled               LogisticsRequest[]        @relation("LogisticsRequestHandledBy")
  labStockMovements                      LabStockMovement[]
  treatingDoctorPatients                 Patient[]                 @relation("TreatingDoctorPatients")
  registeredPatients                     Patient[]                 @relation("PatientRegisteredBy")
  attendingHospitalizations              Hospitalization[]         @relation("HospitalizationAttendingDoctor")
}

enum AgeUnit {
  YEARS
  MONTHS
  DAYS
}

model Patient {
  id          String           @id @default(cuid())
  code        String           @unique
  firstName   String
  lastName    String
  age         Int?
  ageUnit     AgeUnit          @default(YEARS)
  dateOfBirth DateTime?
  phone       String?
  service     String?
  gender      String?
  address     String?
  category    PatientCategory  @default(STANDARD)
  ongName     String?
  recommendedByName String?
  /// Médecin traitant permanent du dossier (optionnel) — distinct du médecin de la visite
  treatingDoctorId String?
  /// Utilisateur qui a créé le dossier à la réception (pour périmètre réceptionniste)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  treatingDoctor User? @relation("TreatingDoctorPatients", fields: [treatingDoctorId], references: [id])
  createdBy     User?  @relation("PatientRegisteredBy", fields: [createdById], references: [id])
  visits        Visit[]
  prescriptions Prescription[]
  invoices      Invoice[]
  dossier       PatientDossier?
  documents     PatientDocument[]
  examReclamations ExamReclamation[]

  @@index([createdById])
}

model PatientDossier {
  id        String   @id @default(cuid())
  patientId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documents PatientDocument[]
}

model PatientDocument {
  id           String              @id @default(cuid())
  dossierId    String
  patientId    String
  visitId      String?
  kind         PatientDocumentKind
  title        String
  documentDate DateTime
  fileName     String
  mimeType     String
  fileSize     Int
  storagePath  String
  uploadedById String
  createdAt    DateTime            @default(now())

  dossier    PatientDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  patient    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit      Visit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([patientId, kind])
  @@index([dossierId, documentDate])
}

model Visit {
  id                      String      @id @default(cuid())
  patientId               String
  status                  VisitStatus @default(WAITING_CONSULTATION)
  assignedDoctorId        String?
  /// Service destinataire (transfert) — visible par les médecins du service tant qu’aucun n’a démarré.
  assignedClinicServiceId String?
  consultationFeeFcfa     Int?
  reductionFcfa           Int?        @default(0)
  notes                   String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  patient               Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignedDoctor        User?            @relation("VisitAssignedDoctor", fields: [assignedDoctorId], references: [id])
  assignedClinicService  ClinicService?   @relation(fields: [assignedClinicServiceId], references: [id], onDelete: SetNull)
  vitalSigns            VitalSign[]
  consultation          Consultation?
  surgeryCase           SurgeryCase?
  hospitalization       Hospitalization?
  invoices              Invoice[]
  prescriptions         Prescription[]
  documents             PatientDocument[]
  examReclamations      ExamReclamation[]

  @@index([patientId])
  @@index([status])
  @@index([assignedClinicServiceId, status])
}

model VitalSign {
  id            String   @id @default(cuid())
  visitId       String
  patientId     String
  weightKg      Float?
  bloodPressure String?
  temperatureC  Float?
  pulseBpm      Int?
  recordedById  String
  recordedAt    DateTime @default(now())

  visit      Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@index([visitId])
}

model Consultation {
  id                   String    @id @default(cuid())
  visitId              String    @unique
  doctorId             String?
  diagnosis            String?
  doctorComment        String?
  clinicalNotes        String?
  needsSurgery         Boolean   @default(false)
  needsHospitalization Boolean   @default(false)
  completedAt          DateTime?
  labSentToLabAt       DateTime?
  labApprovedById      String?
  /// Laborantin ayant saisi / clôturé les résultats labo
  labRecordedById      String?
  labRecordedAt        DateTime?
  labExamReductionFcfa Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  visit         Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  doctor        User? @relation(fields: [doctorId], references: [id])
  labApprovedBy User? @relation("LabApprovedBy", fields: [labApprovedById], references: [id])
  labRecordedBy User? @relation("LabRecordedBy", fields: [labRecordedById], references: [id])
  examReclamations ExamReclamation[]

  @@index([labRecordedById])
}

model InterventionType {
  id                      String               @id @default(cuid())
  code                    String               @unique
  label                   String
  category                InterventionCategory
  totalCostFcfa           Int
  surgeonPercent          Int
  anesthesiologistPercent Int                  @default(0)
  surgeonId               String?
  surgeonName             String?
  anesthesiologistId      String?
  anesthesiologistName    String?
  /// Service clinique auquel l'opération est rattachée
  clinicServiceId         String?
  active                  Boolean              @default(true)

  surgeon              User?                      @relation("InterventionSurgeon", fields: [surgeonId], references: [id])
  anesthesiologist     User?                      @relation("InterventionAnesthesiologist", fields: [anesthesiologistId], references: [id])
  clinicService        ClinicService?             @relation(fields: [clinicServiceId], references: [id], onDelete: SetNull)
  surgeryCases         SurgeryCase[]
  /// Chirurgiens autorisés à utiliser / voir ce type (en plus du service)
  authorizedSurgeons   InterventionTypeSurgeon[]

  @@index([clinicServiceId])
}

/// Chirurgiens explicitement liés à un type d'opération (plusieurs médecins d'un même service).
model InterventionTypeSurgeon {
  id                 String   @id @default(cuid())
  interventionTypeId String
  userId             String
  createdAt          DateTime @default(now())

  interventionType InterventionType @relation(fields: [interventionTypeId], references: [id], onDelete: Cascade)
  user             User             @relation("InterventionAuthorizedSurgeons", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interventionTypeId, userId])
  @@index([userId])
  @@index([interventionTypeId])
}

model ExamCatalogItem {
  id              String          @id @default(cuid())
  kind            ExamCatalogKind
  code            String
  label           String
  category        String?
  priceFcfa       Int
  /// Service clinique auquel l'examen est rattaché (Laboratoire / Hospitalisation = visibles pour tous)
  clinicServiceId String?
  /// Formulaire de résultats labo lié (examens Laboratoire uniquement).
  labPanelId      String?         @unique
  /// Périmètre d'unicité du code : "_" = nomenclature globale du type, sinon id du service.
  serviceScopeKey String          @default("_")
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  clinicService ClinicService? @relation(fields: [clinicServiceId], references: [id], onDelete: SetNull)
  labPanel      LabPanel?      @relation(fields: [labPanelId], references: [id], onDelete: SetNull)

  @@unique([kind, code, serviceScopeKey])
  @@index([kind, active])
  @@index([clinicServiceId])
  @@index([serviceScopeKey])
}

model ExamCatalogServiceTab {
  id              String          @id @default(cuid())
  kind            ExamCatalogKind
  clinicServiceId String
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  clinicService ClinicService @relation(fields: [clinicServiceId], references: [id], onDelete: Cascade)

  @@unique([kind, clinicServiceId])
  @@index([kind, sortOrder])
}

/// Formulaire de résultats laboratoire (panel), géré via le module CRUD du labo.
model LabPanel {
  id        String          @id @default(cuid())
  slug      String          @unique
  label     String
  isEntry   Boolean         @default(true)
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  fields           LabPanelField[]
  examCatalogItems ExamCatalogItem[]

  @@index([active])
}

/// Champ d'un formulaire de résultats laboratoire (aplati : section = titre optionnel).
model LabPanelField {
  id           String   @id @default(cuid())
  panelId      String
  section      String?
  key          String
  label        String
  unit         String?
  reference    String?
  defaultValue String?
  /// Tarif partiel (FCFA) si le médecin ne coche que ce champ ; null = repli sur le tarif examen.
  priceFcfa    Int?
  hasComment   Boolean  @default(false)
  type         String   @default("text")
  sortOrder    Int      @default(0)

  panel     LabPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId])
}

model SurgeryCase {
  id                 String        @id @default(cuid())
  visitId            String        @unique
  interventionTypeId String
  surgeonId          String
  accountantId       String?
  totalCostFcfa      Int
  surgeonShareFcfa   Int
  clinicShareFcfa    Int
  status             SurgeryStatus @default(NOTIFIED)
  paidAt             DateTime?
  authorizedAt       DateTime?
  operationScheduledAt DateTime?
  completedAt        DateTime?
  surgeonPaidAt      DateTime?
  surgeonPaidById    String?
  assistantPaidAt    DateTime?
  assistantPaidById  String?
  clinicPaidAt       DateTime?
  clinicPaidById     String?
  /// Mode de règlement de la part chirurgien (espèces vs paie)
  surgeonPaidMethod  SharePaymentMethod?
  assistantPaidMethod SharePaymentMethod?
  clinicPaidMethod   SharePaymentMethod?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  visit            Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  interventionType InterventionType @relation(fields: [interventionTypeId], references: [id])
  surgeon          User             @relation("SurgeonCases", fields: [surgeonId], references: [id])
  accountant       User?            @relation("SurgeryAccountant", fields: [accountantId], references: [id])
  surgeonPaidBy    User?            @relation("SurgeonPayer", fields: [surgeonPaidById], references: [id])
  assistantPaidBy  User?            @relation("AssistantPayer", fields: [assistantPaidById], references: [id])
  clinicPaidBy     User?            @relation("ClinicPayer", fields: [clinicPaidById], references: [id])
  invoice          Invoice?
  doctorShareClaims DoctorShareClaim[]
}

model Room {
  id            String   @id @default(cuid())
  name          String
  type          RoomType
  description   String?
  dailyRateFcfa Int
  active        Boolean  @default(true)

  beds             Bed[]
  hospitalizations Hospitalization[]
}

model Bed {
  id     String  @id @default(cuid())
  roomId String
  code   String
  label  String?
  active Boolean @default(true)

  room             Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hospitalizations Hospitalization[]

  @@unique([roomId, code])
}

model Hospitalization {
  id            String                @id @default(cuid())
  visitId       String                @unique
  roomId        String?
  bedId         String?
  accountantId  String?
  roomType      RoomType
  dailyRateFcfa Int
  depositFcfa   Int                   @default(0)
  reductionFcfa Int                   @default(0)
  nightsCount   Int                   @default(0)
  totalDueFcfa  Int                   @default(0)
  status        HospitalizationStatus @default(REQUESTED)
  startDate     DateTime?
  endDate       DateTime?
  service              String?
  /// Affichage / impression legacy — synchronisé depuis attendingDoctorId quand possible
  attendingDoctor      String?
  attendingDoctorId    String?
  doctorInstructions   String?
  paidAt        DateTime?
  dischargedAt  DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  visit           Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  room            Room?  @relation(fields: [roomId], references: [id])
  bed             Bed?   @relation(fields: [bedId], references: [id])
  accountant      User?  @relation("HospitalizationAccountant", fields: [accountantId], references: [id])
  attendingDoctorUser User? @relation("HospitalizationAttendingDoctor", fields: [attendingDoctorId], references: [id])
  invoices        Invoice[]
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  patientId         String?
  externalClientId  String?
  visitId           String?
  surgeryCaseId     String?       @unique
  hospitalizationId String?
  type              InvoiceType
  amountFcfa        Int
  paidAmountFcfa    Int           @default(0)
  billingExamKind   String?
  status            InvoiceStatus @default(PENDING)
  issuedById        String
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  patient            Patient?                @relation(fields: [patientId], references: [id])
  externalClient     PharmacyExternalClient? @relation(fields: [externalClientId], references: [id])
  visit              Visit?                  @relation(fields: [visitId], references: [id])
  surgeryCase        SurgeryCase?            @relation(fields: [surgeryCaseId], references: [id])
  hospitalization    Hospitalization?        @relation(fields: [hospitalizationId], references: [id])
  issuedBy           User                    @relation(fields: [issuedById], references: [id])
  pharmacyLines      PharmacySaleLine[]
  cashSettlementLine ReceptionCashSettlementLine?
  payments           InvoicePayment[]
  doctorShareClaims  DoctorShareClaim[]

  @@index([patientId])
  @@index([externalClientId])
  @@index([visitId, billingExamKind])
}

model InvoicePayment {
  id            String         @id @default(cuid())
  invoiceId     String
  amountFcfa    Int
  paymentMethod PaymentMethod?
  paidAt        DateTime       @default(now())
  recordedById  String
  note          String?

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("InvoicePaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  DISPENSATION
}

model PharmacySupplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockMovements StockMovement[]
  products       Product[]

  @@index([name])
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
}

/** Formes galéniques du catalogue pharmacie (Comprimé, Sirop…). */
model ProductForm {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Product {
  id                 String    @id @default(cuid())
  name               String
  sku                String    @unique
  barcode            String?   @unique
  dosage             String?
  pharmaceuticalForm String?
  categoryId         String?
  supplierId         String?
  expiryDate         DateTime? @db.Date
  noExpiry           Boolean   @default(false)
  quantity           Int       @default(0)
  unitPriceFcfa      Int
  purchasePriceFcfa  Int?
  minStock           Int       @default(10)
  sachetsPerBox      Int       @default(1)
  sachetPriceFcfa    Int?
  sellBySachet       Boolean   @default(false)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  category       ProductCategory?  @relation(fields: [categoryId], references: [id])
  supplier       PharmacySupplier? @relation(fields: [supplierId], references: [id])
  saleLines      PharmacySaleLine[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([supplierId])
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  type           StockMovementType
  quantity       Int
  unitCostFcfa   Int?
  supplierId     String?
  reference      String?
  notes          String?
  prescriptionId String?
  userId         String
  stockAfter     Int
  createdAt      DateTime          @default(now())

  product      Product           @relation(fields: [productId], references: [id])
  supplier     PharmacySupplier? @relation(fields: [supplierId], references: [id])
  prescription Prescription?     @relation(fields: [prescriptionId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([createdAt])
}

model Prescription {
  id               String   @id @default(cuid())
  patientId        String?
  externalClientId String?
  visitId          String?
  pharmacistId     String
  notes            String?
  createdAt        DateTime @default(now())

  patient        Patient?                @relation(fields: [patientId], references: [id])
  externalClient PharmacyExternalClient? @relation(fields: [externalClientId], references: [id])
  visit          Visit?                  @relation(fields: [visitId], references: [id])
  pharmacist     User                    @relation(fields: [pharmacistId], references: [id])
  saleLines      PharmacySaleLine[]
  stockMovements StockMovement[]

  @@index([patientId])
  @@index([externalClientId])
}

model PharmacyExternalClient {
  id        String   @id @default(cuid())
  code      String   @unique
  firstName String
  lastName  String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions Prescription[]
  invoices      Invoice[]

  @@index([lastName, firstName])
}

model PharmacySaleLine {
  id             String  @id @default(cuid())
  prescriptionId String
  productId      String
  invoiceId      String?
  quantity       Int
  unitPriceFcfa  Int
  lineTotalFcfa  Int

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
}

model ReceptionCashSettlement {
  id               String             @id @default(cuid())
  receptionistId   String
  accountantId     String
  businessDate     DateTime           @db.Date
  shiftSlot        ReceptionShiftSlot
  systemTotalFcfa  Int
  physicalCashFcfa Int
  disbursementFcfa Int
  varianceFcfa     Int
  isCoherent       Boolean
  comment          String?
  settledAt        DateTime           @default(now())
  createdAt        DateTime           @default(now())

  receptionist User @relation("SettlementReceptionist", fields: [receptionistId], references: [id])
  accountant   User @relation("SettlementAccountant", fields: [accountantId], references: [id])
  lines        ReceptionCashSettlementLine[]
  dayClosure   ReceptionDayClosure?

  @@unique([receptionistId, businessDate, shiftSlot])
  @@index([businessDate, shiftSlot])
}

/// Clôture journalière déclarée par le réceptionniste (avant validation gestionnaire).
model ReceptionDayClosure {
  id             String              @id @default(cuid())
  receptionistId String
  businessDate   DateTime            @db.Date
  shiftSlot      ReceptionShiftSlot?
  collectedFcfa  Int
  expensesFcfa   Int
  netFcfa        Int
  visitsToday    Int                 @default(0)
  registeredToday Int                @default(0)
  comment        String?
  closedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  /// Validation par le gestionnaire (récupération / acceptation de la caisse réception)
  validatedAt    DateTime?
  validatedById  String?
  validationComment String?
  /// Décaissement créé automatiquement à la validation
  settlementId   String?             @unique

  receptionist User  @relation(fields: [receptionistId], references: [id])
  validatedBy  User? @relation("DayClosureValidatedBy", fields: [validatedById], references: [id])
  settlement   ReceptionCashSettlement? @relation(fields: [settlementId], references: [id])

  @@unique([receptionistId, businessDate])
  @@index([businessDate])
  @@index([validatedAt])
}

model ReceptionCashSettlementLine {
  id           String @id @default(cuid())
  settlementId String
  invoiceId    String @unique

  settlement ReceptionCashSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  invoice      Invoice               @relation(fields: [invoiceId], references: [id])

  @@index([settlementId])
}

enum ClinicExpenseCategory {
  FOURNITURES
  TRANSPORT
  MAINTENANCE
  ACHAT_URGENT
  AUTRE
}

enum ClinicExpenseStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum PaymentMethod {
  ESPECES
  VIREMENT
  CHEQUE
}

enum EmployeeContractStatus {
  ACTIF
  EN_CONGE
  INACTIF
}

enum ContractType {
  CDI
  CDD
  PRESTATION
  AUTRE
}

enum PayrollStatus {
  PENDING
  PAID
  LATE
}

enum SalaryAdvanceStatus {
  PENDING
  DEDUCTED
  CANCELLED
}

enum DoctorOvertimeStatus {
  PENDING
  VALIDATED
  REJECTED
  PAID
  CANCELLED
}

/** Nature de la créance médecin (consultations ≠ opérations). */
enum DoctorShareKind {
  CONSULTATION
  OPERATION_SURGEON
  OPERATION_ASSISTANT
}

/** Règlement d’une part : espèces distinct du salaire. */
enum SharePaymentMethod {
  CASH
  PAYROLL
}

enum DoctorShareClaimStatus {
  /// Médecin a demandé l’ajout au salaire (salarié / combiné)
  PENDING_PAYROLL
  /// Réglé en espèces par admin / gestionnaire
  SETTLED_CASH
  /// Inclus dans la paie du mois
  SETTLED_PAYROLL
  REJECTED
  CANCELLED
}

/** Indice / motif prédéfini pour le formulaire de dépense clinique. */
model ClinicExpenseIndice {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String   @default("receipt")
  color     String   @default("#64748b")
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses ClinicExpense[]
}

/** Dépense clinique payée en caisse (réception / comptabilité). */
model ClinicExpense {
  id                String                @id @default(cuid())
  businessDate      DateTime              @db.Date
  amountFcfa        Int
  label             String
  category          ClinicExpenseCategory @default(AUTRE)
  expenseCategoryId String?
  status            ClinicExpenseStatus   @default(VALIDATED)
  comment           String?
  rejectionReason   String?
  beneficiary       String?
  paymentMethod     PaymentMethod?
  receiptPath       String?
  paidById          String
  recordedById      String
  validatedById     String?
  validatedAt       DateTime?
  createdAt         DateTime              @default(now())

  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])
  paidBy          User             @relation("ExpensePaidBy", fields: [paidById], references: [id])
  recordedBy      User             @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  validatedBy     User?            @relation("ExpenseValidatedBy", fields: [validatedById], references: [id])

  @@index([businessDate])
  @@index([paidById, businessDate])
  @@index([status])
}

/** Fiche de paie mensuelle — suivi admin des salaires. */
model EmployeePayroll {
  id         String        @id @default(cuid())
  year       Int
  month      Int
  employeeId String
  grossFcfa            Int
  primeFcfa            Int            @default(0)
  advanceDeductionFcfa Int            @default(0)
  status        PayrollStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  remarks       String?
  paidAt        DateTime?
  paidById   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paidBy   User?    @relation("PayrollPaidBy", fields: [paidById], references: [id])

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([status])
}

/** Avance sur salaire — déduite à la prochaine paie. */
model SalaryAdvance {
  id              String              @id @default(cuid())
  employeeId      String
  amountFcfa      Int
  /// Solde restant à déduire (démarre égal à amountFcfa).
  remainingFcfa   Int
  /// Montant déduit à chaque paie ; null = tout le solde d'un coup.
  installmentFcfa Int?
  businessDate    DateTime            @db.Date
  comment         String?
  status          SalaryAdvanceStatus @default(PENDING)
  payrollYear     Int?
  payrollMonth    Int?
  recordedById    String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy User     @relation("SalaryAdvanceRecordedBy", fields: [recordedById], references: [id])

  @@index([employeeId, status])
  @@index([businessDate])
  @@index([status])
}

/** Heures supplémentaires médecin — soumises puis validées par le gestionnaire. */
model DoctorOvertimeEntry {
  id               String               @id @default(cuid())
  employeeId       String
  businessDate     DateTime             @db.Date
  startTime        String?
  endTime          String?
  /// Durée en minutes (source de vérité pour le calcul)
  minutesWorked    Int
  hourlyRateFcfa   Int
  amountFcfa       Int                  @default(0)
  comment          String?
  status           DoctorOvertimeStatus @default(PENDING)
  payrollYear      Int?
  payrollMonth     Int?
  rejectionReason  String?
  recordedById     String
  validatedById    String?
  validatedAt      DateTime?
  paidAt           DateTime?
  paidById         String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy  User     @relation("OvertimeRecordedBy", fields: [recordedById], references: [id])
  validatedBy User?    @relation("OvertimeValidatedBy", fields: [validatedById], references: [id])
  paidBy      User?    @relation("OvertimePaidBy", fields: [paidById], references: [id])

  @@index([employeeId, status])
  @@index([businessDate])
  @@index([status])
  @@index([payrollYear, payrollMonth])
}

/**
 * Créance médecin (consultation ou opération) :
 * règlement espèces (admin/gest) OU demande d’ajout au salaire (médecin salarié).
 * À percevoir = parts non réglées et hors PENDING_PAYROLL.
 */
model DoctorShareClaim {
  id              String                 @id @default(cuid())
  employeeId      String
  doctorUserId    String
  kind            DoctorShareKind
  amountFcfa      Int
  businessDate    DateTime               @db.Date
  surgeryCaseId   String?
  invoiceId       String?
  status          DoctorShareClaimStatus @default(PENDING_PAYROLL)
  payrollYear     Int?
  payrollMonth    Int?
  comment         String?
  rejectionReason String?
  requestedById   String
  settledById     String?
  settledAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  doctorUser  User         @relation("DoctorShareClaims", fields: [doctorUserId], references: [id])
  surgeryCase SurgeryCase? @relation(fields: [surgeryCaseId], references: [id], onDelete: Cascade)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  requestedBy User         @relation("DoctorShareRequestedBy", fields: [requestedById], references: [id])
  settledBy   User?        @relation("DoctorShareSettledBy", fields: [settledById], references: [id])

  @@unique([surgeryCaseId, kind])
  @@unique([invoiceId, kind])
  @@index([doctorUserId, status])
  @@index([employeeId, status])
  @@index([businessDate])
  @@index([status])
  @@index([payrollYear, payrollMonth])
}

/** Coupure de monnaie entre caissiers (un envoie le patient chez l'autre pour la monnaie). */
model CashChangeTransfer {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  /** Caissier qui n'avait pas la monnaie (envoie le patient). */
  requesterId  String
  /** Caissier qui a donné la monnaie au patient. */
  providerId   String
  amountFcfa   Int
  patientHint  String?
  comment      String?
  recordedById String
  refundedAt   DateTime?
  refundedById String?
  createdAt    DateTime @default(now())

  requester  User  @relation("ChangeRequester", fields: [requesterId], references: [id])
  provider   User  @relation("ChangeProvider", fields: [providerId], references: [id])
  recordedBy User  @relation("ChangeRecordedBy", fields: [recordedById], references: [id])
  refundedBy User? @relation("ChangeRefundedBy", fields: [refundedById], references: [id])

  @@index([businessDate])
  @@index([requesterId, businessDate])
  @@index([providerId, businessDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model ExamReclamation {
  id             String                @id @default(cuid())
  consultationId String
  visitId        String
  patientId      String
  examKind       String?
  examLabel      String?
  examLines      Json?
  totalFcfa      Int                   @default(0)
  reason         ExamReclamationReason
  reasonDetail   String?
  status         ExamReclamationStatus @default(PENDING)
  createdById    String
  handledById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  resolvedAt     DateTime?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ExamReclamationCreatedBy", fields: [createdById], references: [id])
  handledBy    User?        @relation("ExamReclamationHandledBy", fields: [handledById], references: [id])

  @@index([patientId])
  @@index([consultationId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Gestion de stock logistique (consommables & matériel non-médicament)
// Distinct de la pharmacie : fournitures, matériel médical, réactifs, bureautique.
// ---------------------------------------------------------------------------

enum LogisticsMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum LogisticsRequestStatus {
  PENDING
  FULFILLED
  REJECTED
}

model LogisticsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LogisticsItem[]

  @@index([sortOrder])
}

model LogisticsSupplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     LogisticsItem[]
  movements LogisticsStockMovement[]

  @@index([name])
}

model LogisticsItem {
  id                String    @id @default(cuid())
  name              String
  sku               String    @unique
  reference         String?
  unit              String    @default("unité")
  /** Nombre d'unités de base dans un paquet (1 = pas de paquet). */
  unitsPerPackage   Int       @default(1)
  /** Nombre de paquets dans un carton (1 = pas de carton). */
  packagesPerCarton Int       @default(1)
  categoryId        String?
  supplierId        String?
  /** Stock toujours stocké en unités de base. */
  quantity          Int       @default(0)
  unitCostFcfa      Int       @default(0)
  minStock          Int       @default(5)
  expiryDate        DateTime? @db.Date
  noExpiry          Boolean   @default(true)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category     LogisticsCategory?       @relation(fields: [categoryId], references: [id])
  supplier     LogisticsSupplier?       @relation(fields: [supplierId], references: [id])
  movements    LogisticsStockMovement[]
  requestLines LogisticsRequestLine[]

  @@index([categoryId])
  @@index([supplierId])
}

model LogisticsStockMovement {
  id           String                @id @default(cuid())
  itemId       String
  type         LogisticsMovementType
  quantity     Int
  unitCostFcfa Int?
  supplierId   String?
  reference    String?
  notes        String?
  requestId    String?
  userId       String
  stockAfter   Int
  createdAt    DateTime              @default(now())

  item     LogisticsItem      @relation(fields: [itemId], references: [id])
  supplier LogisticsSupplier? @relation(fields: [supplierId], references: [id])
  request  LogisticsRequest?  @relation(fields: [requestId], references: [id])
  user     User               @relation(fields: [userId], references: [id])

  @@index([itemId, createdAt])
  @@index([createdAt])
}

model LogisticsRequest {
  id            String                 @id @default(cuid())
  code          String                 @unique
  service       String
  status        LogisticsRequestStatus @default(PENDING)
  notes         String?
  requestedById String
  handledById   String?
  handledAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  requestedBy User                     @relation("LogisticsRequestRequestedBy", fields: [requestedById], references: [id])
  handledBy   User?                    @relation("LogisticsRequestHandledBy", fields: [handledById], references: [id])
  lines       LogisticsRequestLine[]
  movements   LogisticsStockMovement[]

  @@index([status])
  @@index([createdAt])
}

model LogisticsRequestLine {
  id                String @id @default(cuid())
  requestId         String
  itemId            String
  quantityRequested Int
  quantityIssued    Int    @default(0)

  request LogisticsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    LogisticsItem    @relation(fields: [itemId], references: [id])

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Stock laboratoire (réactifs / consommables) — gestionnaire & direction
// ---------------------------------------------------------------------------

enum LabStockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

model LabStockCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LabStockItem[]

  @@index([sortOrder])
}

model LabStockItem {
  id           String    @id @default(cuid())
  name         String
  sku          String    @unique
  reference    String?
  unit         String    @default("unité")
  categoryId   String?
  quantity     Int       @default(0)
  unitCostFcfa Int       @default(0)
  minStock     Int       @default(5)
  expiryDate   DateTime? @db.Date
  noExpiry     Boolean   @default(true)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category  LabStockCategory?   @relation(fields: [categoryId], references: [id])
  movements LabStockMovement[]

  @@index([categoryId])
  @@index([name])
}

model LabStockMovement {
  id           String               @id @default(cuid())
  itemId       String
  type         LabStockMovementType
  quantity     Int
  unitCostFcfa Int?
  reference    String?
  notes        String?
  userId       String
  stockAfter   Int
  createdAt    DateTime             @default(now())

  item LabStockItem @relation(fields: [itemId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@index([itemId, createdAt])
  @@index([createdAt])
}

/// Profil établissement (singleton) — en-têtes tickets / PDF / exports.
model ClinicInfo {
  id          String   @id @default("default")
  nameFr      String
  nameAr      String
  shortName   String
  logo        String
  city        String
  address     String
  fullAddress String
  phones      String
  phoneLabel  String
  email       String
  /// Identifiant fiscal (NIF)
  nif         String   @default("")
  /// Registre de commerce (RC)
  rc          String   @default("")
  /// Mention libre affichée en pied d’impression
  printFooter String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Overrides de visibilité des boutons UI par rôle (masquer uniquement ; défaut = rôles actuels).
model RoleUiSettings {
  id           String   @id @default("default")
  /// { "GESTIONNAIRE": ["table.delete", ...], ... }
  hiddenByRole Json     @default("{}")
  updatedAt    DateTime @updatedAt
  updatedById  String?
}

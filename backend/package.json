{
  "name": "alwatan-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:generate": "prisma generate && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:doctor-fields": "tsx scripts/_migrate-doctor-fields.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:restore-users": "tsx scripts/restore-users.ts",
    "db:superadmin-only": "tsx scripts/ensure-superadmin-only.ts",
    "db:split-routine-hormones": "tsx scripts/_split-routine-hormones-panel.ts",
    "db:seed:demo": "SEED_DEMO_RESET=1 npm run db:seed",
    "db:reset": "tsx scripts/reset-database.ts",
    "db:purge-patients-expenses": "tsx scripts/purge-patients-and-expenses.ts",
    "db:reset-operational": "tsx scripts/reset-operational-data.ts",
    "db:setup": "npx prisma db push && npm run db:seed",
    "db:docker:up": "docker compose -f ../docker-compose.yml up -d postgres",
    "db:docker:down": "docker compose -f ../docker-compose.yml down",
    "db:docker:logs": "docker compose -f ../docker-compose.yml logs -f postgres",
    "db:docker:setup": "npm run db:docker:up && npx prisma db push && npm run db:seed",
    "db:import-pharmacy": "tsx scripts/import-syntalsoft-pharmacy.ts",
    "db:rename-pharmacy-categories": "tsx scripts/rename-pharmacy-categories.ts",
    "db:migrate-pharmacy-categories-to-forms": "tsx scripts/migrate-pharmacy-categories-to-forms.ts",
    "test": "tsx --test src/lib/pharmacy-returns.test.ts src/lib/patient-code.test.ts src/lib/password-policy.test.ts src/lib/consultation-invoice.test.ts src/lib/auth.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}

# Base PostgreSQL locale — base existante alwatan
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5433/alwatan?schema=public"
# Placeholder uniquement. En production, générez un secret (node backend/scripts/rotate-jwt-secret.mjs).
JWT_SECRET="changez-ce-secret-en-production-lan-clinique-alwatan"
PORT=4000
HOST=0.0.0.0
# Origins autorisées (dev + production). L'installeur production met à jour cette ligne.
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000"
# 1 = servir frontend/dist depuis l'API (recommandé en production LAN)
SERVE_FRONTEND=1
# FRONTEND_DIST=C:\chemin\vers\frontend\dist
# HTTPS optionnel (PWA installable sur le LAN) — voir scripts/deploy/PWA-ET-HTTPS.md
# SSL_KEY_PATH=C:\chemin\vers\server.key
# SSL_CERT_PATH=C:\chemin\vers\server.crt
# COOKIE_SECURE=1  # uniquement avec HTTPS. Ne pas activer en HTTP LAN (cookies refusés sur les postes clients).
# --- Sauvegarde automatique (toutes les 2 h par défaut) ---
# BACKUP_ENABLED=1
# BACKUP_INTERVAL_HOURS=2
# BACKUP_KEEP_DAYS=7
# BACKUP_RUN_ON_START=1
# BACKUP_DIR=C:\chemin\vers\backups
# Cloud (à brancher plus tard) :
# BACKUP_CLOUD_ENABLED=0
# BACKUP_CLOUD_PROVIDER=
# --- Verrou anti-suppression externe (DELETE/TRUNCATE/DROP hors boutons UI) ---
# Les boutons de l'application restent autorisés. Pour maintenance SQL manuelle :
#   SELECT set_config('alwatan.allow_delete', '1', false);
# Puis exécutez DELETE/DROP. Les scripts npm confirmés (--confirm) sont déjà déverrouillés.

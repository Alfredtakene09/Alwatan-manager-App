# Adresses du poste serveur (detection automatique au demarrage)
# SERVER_IP     = IP Ethernet cablee du serveur (DHCP auto recommande)
# TAILSCALE_IP  = mesh Tailscale (1 utilisateur distant : PC / mobile)
#
# Exemple :
# SERVER_IP=192.168.88.208
# TAILSCALE_IP=100.88.27.41
#
# Les clients Ethernet se connectent automatiquement via le raccourci Alwatan
# (decouverte si l'IP DHCP du serveur change).
SERVER_IP=
TAILSCALE_IP=
